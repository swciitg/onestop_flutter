<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tap-to-dismiss scrim -->
    <View
        android:id="@+id/overlayScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Centered card -->
    <LinearLayout
        android:id="@+id/overlayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/gatelog_overlay_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Header: title + close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Gatelog"
                android:textColor="#FDFDFCFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayCloseBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="\u2715"
                android:textColor="#9B9B9B"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close" />
        </RelativeLayout>

        <!-- Destination label -->
        <TextView
            android:id="@+id/overlayDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#14BD56"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Destination input for "Others" -->
        <EditText
            android:id="@+id/overlayDestinationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/gatelog_widget_button_outline_dark"
            android:hint="Enter destination"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Submit button for "Others" -->
        <TextView
            android:id="@+id/overlaySubmitBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/gatelog_overlay_button"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- QR code image -->
        <ImageView
            android:id="@+id/overlayQrImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="QR Code"
            android:visibility="gone" />

        <!-- Progress spinner -->
        <ProgressBar
            android:id="@+id/overlayProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminateTint="#14BD56"
            android:visibility="visible" />

        <!-- Success icon (checkmark) -->
        <TextView
            android:id="@+id/overlaySuccessIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/gatelog_overlay_success"
            android:gravity="center"
            android:text="\u2713"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:visibility="gone" />

        <!-- Status text -->
        <TextView
            android:id="@+id/overlayStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Connecting..."
            android:textColor="#9B9B9B"
            android:textSize="14sp" />

    </LinearLayout>
</FrameLayout>
