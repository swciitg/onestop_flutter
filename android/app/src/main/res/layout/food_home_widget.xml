<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/foodWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/food_widget_background_light"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Food title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/foodTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Food"
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Meal badge: e.g. LUNCH • ENDS 2:30 PM -->
    <TextView
        android:id="@+id/foodMealBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF98999F"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Menu items (single TextView, fills remaining space, clips at boundary) -->
    <TextView
        android:id="@+id/foodItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textColor="#FF000000"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- No data message -->
    <TextView
        android:id="@+id/foodNoData"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No menu data"
        android:textColor="#FF98999F"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
