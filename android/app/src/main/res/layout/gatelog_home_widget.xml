<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gatelog_widget_background_light"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <TextView
        android:id="@+id/glTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gatelog"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Default state: 3 destination buttons -->
    <LinearLayout
        android:id="@+id/glDefaultSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/glBtnCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gatelog_widget_button_outline_light"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="To City"
            android:textColor="#FF1AB056"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glBtnKhokha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/gatelog_widget_button_outline_light"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="To Khokha"
            android:textColor="#FF1AB056"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glBtnOthers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/gatelog_widget_button_outline_light"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Others"
            android:textColor="#FF1AB056"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Checked-out state: show check-in info -->
    <LinearLayout
        android:id="@+id/glCheckedOutSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/glCheckInLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Check into\nCampus"
            android:textColor="#FF6E6F77"
            android:textSize="13sp" />

        <!-- Gate closing info -->
        <TextView
            android:id="@+id/glGateInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF98999F"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/glBtnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/gatelog_widget_button_outline_light"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Check-In"
            android:textColor="#FF1AB056"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
