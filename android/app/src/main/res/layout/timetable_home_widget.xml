<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ttWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/timetable_widget_background_light"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Title • Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ttTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Table"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="•"
            android:textColor="#FF98999F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ttDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF98999F"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- No-class message (shown when no actual classes) -->
    <TextView
        android:id="@+id/ttNoClassMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Two-column section (shown when classes exist) -->
    <LinearLayout
        android:id="@+id/ttClassesSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <!-- Left: Current/Next class highlight card -->
        <LinearLayout
            android:id="@+id/ttLeftCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="@drawable/timetable_widget_left_card_blue_light"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Status badge -->
            <TextView
                android:id="@+id/ttStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FF005FF0"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="UP NEXT"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Time remaining / info -->
            <TextView
                android:id="@+id/ttTimeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Course code -->
            <TextView
                android:id="@+id/ttCourseCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Course name -->
            <TextView
                android:id="@+id/ttCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />

            <!-- Class time -->
            <TextView
                android:id="@+id/ttClassTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Right: Upcoming classes list -->
        <LinearLayout
            android:id="@+id/ttRightSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="4"
            android:orientation="vertical">

            <!-- Upcoming class 1 -->
            <LinearLayout
                android:id="@+id/ttUpcoming1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/timetable_widget_inner_card_light"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ttUpcoming1Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ttUpcoming1Course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Upcoming class 2 -->
            <LinearLayout
                android:id="@+id/ttUpcoming2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/timetable_widget_inner_card_light"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ttUpcoming2Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ttUpcoming2Course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Upcoming class 3 (hidden by default, kept for compatibility) -->
            <LinearLayout
                android:id="@+id/ttUpcoming3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/timetable_widget_inner_card_light"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ttUpcoming3Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ttUpcoming3Course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Updated at footer (hidden to save space) -->
    <TextView
        android:id="@+id/ttUpdatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF98999F"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
