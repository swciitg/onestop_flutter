<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ttWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/timetable_widget_background_light"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ttTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Table"
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="•"
            android:textColor="#FF98999F"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ttDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF98999F"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ttHeadlineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ttHeadlinePrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttHeadlineValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FF148440"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ttNextCourse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FF6E6F77"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/ttOtherCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/timetable_widget_inner_card_light"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/ttOtherTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF6E6F77"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttOtherCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ttUpdatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF98999F"
        android:textSize="11sp" />
</LinearLayout>
